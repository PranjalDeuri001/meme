# API Configuration - Copy to .env and set your values
# Vite loads these at build time; restart dev server after changes.

# Backend REST API base URL (no trailing slash)
# Examples: http://localhost:8002, https://api.example.com
VITE_API_URL_3=http://localhost:8002

# WebSocket URL for live data (ws:// for http, wss:// for https)
# Should match API host and port
VITE_WS_URL=ws://localhost:8002

# Optional: Google Maps API key for geocoding/places
VITE_GOOGLE_API_KEY=
